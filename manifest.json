{
  "manifest_version": 3,
  "name": "Jaga Comments Toggle",
  "version": "1.1.0",
  "description": "Показывает и скрывает блок комментариев на jaga.rt.ru.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://jaga.rt.ru/browse/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
